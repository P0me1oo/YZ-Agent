# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"   # 新安装默认 singbox，VLESS 默认 xray；机器模式按面板节点分别选择
#                     # 已有配置省略 type 时仍按 xray 加载，不因升级改变内核
# log:
#   level: "info"
#   # 运行日志是否永久停用由面板的机器设置控制，本地日志级别不能重新开启。
# time_sync:
#   enabled: true                 # 只校准 Node 进程内协议时间，不修改系统时间
#   servers:
#     - "time.cloudflare.com"
#     - "time.google.com"
#     - "pool.ntp.org"
#   interval: 600                 # 查询间隔，单位：秒
#   timeout: 3                    # 单个 NTP 源超时，单位：秒
#   warn_offset: 5                # 偏移达到 5 秒时告警
#   error_offset: 15              # 偏移达到 15 秒时标记错误
#   critical_offset: 25           # 偏移达到 25 秒时标记严重错误
# firewall:
#   enabled: true                 # Linux 上按节点实际运行状态管理端口
#   backend: auto                 # auto / ufw / firewalld / none
#   redirect_backend: auto        # auto / nftables / iptables，用于 HY2 跳跃
#   source_backend: auto          # auto / nftables / iptables；来源过滤必须成功才启动节点
#   zone: ""                      # firewalld 留空使用活动区域和默认区域
#   state_dir: "firewall"          # 相对配置文件目录，同进程实例必须共用
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── Xray REALITY ──
# kernel:
#   type: "xray"
#   reality_min_client_ver: "0.0.0"   # REALITY 最低客户端版本，三段数字；留空按 0.0.0 处理
#                                     # 详见 docs-xray-reality.md
